/* SealedLore's stylesheet. Colours and the monospace font are names (@panel,
   @font_mono), filled in from the theme (gui/theme.py): write new colours
   into the themes, never here. */

QWidget {
  background-color: @window;
  color: @text;
  font-size: 14px;
}

QMainWindow::separator {
  background: @separator;
  width: 4px;
  height: 4px;
}

/* The divider between the story and the composer: drag it to make the box
   you type in taller. A short grip line shows where it is. */
#storySplit::handle:vertical {
  background: transparent;
  image: @grip;
}

#storySplit::handle:vertical:hover {
  background: @separator;
}

/* --- docks ---------------------------------------------------------- */

QDockWidget {
  titlebar-close-icon: none;
  titlebar-normal-icon: none;
  font-size: 12px;
}

QDockWidget::title {
  background: @panel;
  padding: 7px 10px;
  border-bottom: 1px solid @border;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: @text_dim;
}

/* Padding here never reached the layout: the centre's margins are set in
   code (main_window.CENTRE_MARGIN). */
#centre {
  background: @window;
}

/* --- transcript ----------------------------------------------------- */

#transcript {
  border: 1px solid @border;
  border-radius: 8px;
  background: @field;
}

#transcriptContainer {
  background: @field;
}

#message {
  background: @panel;
  border: 1px solid @border;
  border-radius: 8px;
}

#message[kind="assistant"] {
  background: @panel;
  border-left: 3px solid @kind_passage;
}

#message[kind="character"] {
  background: @turn_bg;
  border-left: 3px solid @kind_turn;
}

#message[kind="narration"] {
  background: @narration_bg;
  border-left: 3px solid @kind_narration;
}

#message[kind="director"] {
  background: @director_bg;
  border-left: 3px solid @kind_director;
}

/* An aside is about the story, not in it: set apart, and never archived. */
#message[kind="aside"] {
  background: @aside_bg;
  border: 1px dashed @aside_border;
  border-left: 3px solid @kind_aside;
}

/* A chapter as the storyteller is given it (the "As sent" view). */
#message[kind="summary"] {
  background: @summary_bg;
  border: 1px solid @summary_border;
  border-left: 3px solid @kind_summary;
}

#viewNote {
  color: @text_hint;
  font-size: 12px;
  font-style: italic;
  background: transparent;
}

/* The rows above and below the built part of the transcript (transcript.py). */
#earlierButton, #laterButton, #jumpButton {
  background: transparent;
  border: 1px dashed @control_border;
  border-radius: 6px;
  color: @text_dim;
  padding: 6px;
}

#jumpButton {
  padding: 6px 12px;
}

#earlierButton:hover, #laterButton:hover, #jumpButton:hover {
  color: @text_accent;
  border-color: @hover_border_accent;
}

#viewToggleButton {
  background: @panel;
  border: 1px solid @control_border;
  color: @text_dim;
  padding: 3px 12px;
  font-size: 12px;
}

#viewToggleButton:checked {
  background: @selection;
  color: @text_accent;
  border-color: @checked_border;
}

/* The branch being read, above the transcript (gui/branch_bar.py). */
#branchButton {
  background: @panel;
  border: 1px solid @control_border;
  border-radius: 4px;
  color: @text_accent;
  font-weight: 600;
  padding: 3px 10px;
  font-size: 12px;
}

#branchButton:hover {
  border-color: @checked_border;
}

#branchButton[popupMode="2"] {
  padding-right: 24px;
}

/* The story map's hover card (gui/story_map.py): it stays while read. */
#mapCard {
  background: @button;
  color: @text_bright;
  border: 1px solid @hover_border;
  border-radius: 4px;
  padding: 8px 10px;
  font-size: 13px;
}

/* Where a branch begins: the one place in the story it shows. */
#branchStart {
  background: transparent;
  color: @accent;
  font-size: 12px;
  font-style: italic;
}

/* A picture of the story, never part of what the storyteller sees. */
#message[kind="picture"] {
  background: @picture_bg;
  border: 1px solid @border;
  border-left: 3px solid @kind_picture;
}

#message[kind="aside"] #messageBody {
  color: @aside_text;
  font-size: 14px;
}

#asideQuestion {
  color: @aside_question;
  font-size: 13px;
  font-style: italic;
  background: transparent;
}

#messageHeader {
  color: @text_dim;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1px;
  background: transparent;
}

/* Archived prose still reads as the story, just quieter: the model now sees
   it only as a chapter summary (§5.2). */
#message[archived="true"] {
  background: @archived_bg;
  border-style: dashed;
}

#message[archived="true"] #messageBody {
  color: @archived_text;
}

#messageAction {
  background: transparent;
  border: 1px solid @control_border;
  border-radius: 4px;
  padding: 2px 8px;
  color: @text_hint;
  font-size: 11px;
}

#messageAction:hover {
  background: @button;
  color: @text;
}

/* ‹ 2 / 4 › — the take cycler (§10). */
#variantButton {
  background: transparent;
  border: none;
  color: @text_dim;
  font-size: 14px;
  padding: 0 4px;
}

#variantButton:hover {
  color: @text_bright;
}

#variantButton:disabled {
  color: @text_disabled_faint;
}

#variantLabel {
  color: @text_dim;
  font-size: 11px;
  background: transparent;
}

#reasoningToggle {
  background: transparent;
  border: none;
  color: @text_placeholder;
  font-size: 11px;
  padding: 0;
}

#reasoningToggle:hover {
  color: @text_soft;
}

#messageReasoning {
  color: @text_dim;
  font-size: 12px;
  font-style: italic;
  background: @window;
  border-left: 2px solid @button_border;
  padding: 6px 8px;
}

#messageUsage {
  color: @text_faint;
  font-size: 11px;
  background: transparent;
}

#messageEditor {
  background: @field;
  border: 1px solid @checked_border;
  border-radius: 6px;
  padding: 8px;
  color: @text_bright;
  font-size: 15px;
}

#messageBody {
  color: @story_text;
  font-size: 15px;
  line-height: 152%;
  background: transparent;
}

#message[kind="narration"] #messageBody {
  color: @narration_text;
  font-style: italic;
}

#message[kind="director"] #messageBody {
  color: @director_text;
}

#messageOoc {
  color: @ooc_text;
  font-size: 13px;
  font-style: italic;
  background: transparent;
  border-top: 1px dashed @button_border;
  padding-top: 6px;
}

#messageNote {
  color: @warning;
  font-size: 13px;
  background: @warning_bg;
  border: 1px solid @warning_border;
  border-radius: 6px;
  padding: 6px 8px;
}

#placeholder {
  color: @text_placeholder;
  padding: 48px 24px;
  background: transparent;
}

/* The first-run welcome: instructions to follow, so not dimmed. */
#welcome {
  padding: 32px 24px 16px 24px;
  background: transparent;
}

/* The start page and File → New… (start_page.py): every way to begin, a card
   each with its title and a sentence. */
#startPage, #startColumn {
  background: transparent;
  border: none;
}

#startHeading {
  color: @text_heading;
  font-size: 22px;
  font-weight: 600;
  padding-bottom: 4px;
}

#startSection {
  color: @text_heading;
  font-size: 17px;
  font-weight: 600;
  padding-top: 8px;
}

#startSectionText {
  color: @text_dim;
  padding-bottom: 4px;
}

#startCard {
  background: @panel;
  border: 1px solid @border;
  border-radius: 8px;
}

#startCard:hover {
  background: @button_hover;
  border-color: @hover_border_accent;
}

#startCard:focus {
  border: 2px solid @accent;
}

#startCardTitle {
  color: @text_bright;
  font-size: 16px;
  font-weight: 600;
  background: transparent;
}

#startCardText {
  color: @text_soft;
  background: transparent;
}

#startPicture {
  background: @window;
  border-top-left-radius: 7px;
  border-top-right-radius: 7px;
}

/* --- Settings' pages (gui/settings_pages.py) --------------------------- */

#settingsNav {
  background: @panel;
  border: 1px solid @border;
  border-radius: 6px;
  padding: 6px 0px;
}

#settingsNav::item {
  padding: 6px 12px;
  color: @text;
}

#settingsNav::item:selected {
  background: @selection;
  color: @text_selected;
}

#settingsNav::item:disabled {
  color: @text_hint;
  font-size: 11px;
  padding: 12px 12px 2px 12px;
}

#settingsHeading {
  color: @text_heading;
  font-size: 18px;
  font-weight: 600;
}

#settingsAbout {
  color: @text_soft;
}

/* A heading that opens the rows under it: Advanced and the like. */
#foldButton {
  background: transparent;
  border: none;
  color: @accent;
  padding: 8px 0px 4px 0px;
  font-weight: 600;
}

#foldButton:hover {
  color: @text_accent;
}

/* --- the People page (gui/people_page.py) ----------------------------- */

#peoplePage, #peopleColumn {
  background: transparent;
  border: none;
}

#peopleHeading {
  color: @text_heading;
  font-size: 17px;
  font-weight: 600;
}

#peopleSituation {
  color: @text_soft;
}

#peopleSection {
  color: @text_heading;
  font-size: 14px;
  font-weight: 600;
  padding-top: 10px;
}

#personCard {
  background: @panel;
  border: 1px solid @border;
  border-radius: 8px;
}

#personCard[you="true"] {
  border: 1px solid @checked_border;
}

#personCard:hover {
  background: @button_hover;
  border-color: @hover_border_accent;
}

#personCard:focus {
  border: 2px solid @accent;
}

#personPicture {
  background: @window;
  border-top-left-radius: 7px;
  border-top-right-radius: 7px;
}

#personName {
  color: @text_bright;
  font-size: 15px;
  font-weight: 600;
  background: transparent;
}

#personYou {
  color: @accent;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1px;
  background: transparent;
}

#personNote {
  color: @text_accent;
  font-size: 12px;
  background: transparent;
}

#personLine {
  color: @text_dim;
  font-size: 12px;
  background: transparent;
}

#personAction {
  padding: 3px 8px;
  font-size: 12px;
}

#peopleTip {
  background: @panel;
  border: 1px solid @hover_border_accent;
  border-radius: 8px;
}

#peopleTipTitle {
  color: @text_bright;
  font-weight: 600;
  background: transparent;
}

#peopleTipText {
  color: @text_soft;
  background: transparent;
}

/* A button that reads as a link: Not now, Correct the scene. */
#linkButton {
  background: transparent;
  border: none;
  color: @accent;
  padding: 2px 0px;
}

#linkButton:hover {
  text-decoration: underline;
}

/* --- composer ------------------------------------------------------- */

#input {
  background: @panel;
  border: 1px solid @control_border;
  border-radius: 8px;
  padding: 10px;
  color: @text_bright;
  font-size: 15px;
  selection-background-color: @text_selection;
}

#input:focus {
  border: 1px solid @accent;
}

#input:disabled {
  background: @field_disabled;
  color: @text_faint;
}

/* --- staleness banner (§5.3) ----------------------------------------- */

#stalenessBanner {
  background: @warning_bg;
  border: 1px solid @warning_border;
  border-radius: 8px;
}

#stalenessText {
  color: @warning;
  font-size: 13px;
  background: transparent;
}

#driftLabel {
  color: @warning;
  font-size: 13px;
  background: @warning_bg;
  border: 1px solid @warning_border;
  border-radius: 6px;
  padding: 8px;
}

#composerCaption {
  color: @text_hint;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1px;
  background: transparent;
}

#oocInput {
  background: @ooc_bg;
  border: 1px solid @ooc_border;
  border-radius: 8px;
  padding: 8px;
  color: @director_text;
  font-size: 14px;
}

#oocInput:focus {
  border-color: @ooc_focus;
}

QToolButton {
  background: @button;
  border: 1px solid @button_border;
  border-radius: 6px;
  padding: 6px 10px;
  color: @text;
}

QToolButton:hover {
  background: @button_hover;
  border-color: @hover_border;
}

QToolButton:pressed {
  background: @button_pressed;
}

QToolButton:disabled {
  color: @text_disabled;
  border-color: @border;
}

/* A button that opens a menu: a chevron at its right, centred. Qt's own was
   a dark speck in the corner (the author, Oct 18 2026). Buttons with padding
   of their own (an id's rule) make room for it below. */
QToolButton[popupMode="2"] {
  padding-right: 26px;
}

QToolButton::menu-indicator {
  image: @chevron_down;
  subcontrol-origin: padding;
  subcontrol-position: center right;
  right: 7px;
  width: 12px;
  height: 12px;
}

QToolButton::menu-indicator:disabled {
  image: @chevron_down_disabled;
}

#messageAction[popupMode="2"] {
  padding-right: 20px;
}

#messageAction::menu-indicator {
  right: 4px;
  width: 10px;
  height: 10px;
}

#viewToggleButton[popupMode="2"] {
  padding-right: 24px;
}

#viewToggleButton::menu-indicator {
  right: 6px;
}

QPushButton {
  background: @button;
  border: 1px solid @button_border;
  border-radius: 7px;
  padding: 7px 16px;
  color: @text;
}

QPushButton:focus {
  border-color: @hover_border_accent;
}

QPushButton::menu-indicator {
  image: @chevron_down;
  subcontrol-origin: padding;
  subcontrol-position: center right;
  width: 12px;
  height: 12px;
}

QPushButton:hover {
  background: @button_hover;
  border-color: @hover_border;
}

QPushButton:pressed {
  background: @button_pressed;
}

QPushButton:disabled {
  background: @button_disabled;
  color: @text_disabled;
  border-color: @border;
}

/* Small square buttons (a row's remove, move up/down): the padding above
   would swallow a one-character label. */
QPushButton#smallButton {
  padding: 4px 6px;
  min-width: 22px;
}

#sendButton {
  background: @primary;
  border-color: @primary_border;
  color: @primary_text;
  font-weight: 600;
}

#sendButton:hover {
  background: @primary_hover;
}

#sendButton:disabled {
  background: @button;
  color: @text_disabled;
  border-color: @border;
}

/* --- lists, trees, tabs --------------------------------------------- */

QListWidget, QTreeWidget, QPlainTextEdit, QTextEdit {
  background: @field;
  border: 1px solid @border;
  border-radius: 6px;
  color: @text;
}

QListWidget, QTreeWidget {
  outline: none;
}

QListWidget::item {
  padding: 8px 8px;
  border-bottom: 1px solid @list_divider;
}

/* A story's row is two or three lines already (stories._StoryRow). */
#storyList::item {
  padding: 6px 8px;
}

QListWidget::item:selected, QTreeWidget::item:selected {
  background: @selection;
  color: @text_selected;
}

QTreeWidget::item {
  padding: 4px 2px;
}

QTreeWidget {
  alternate-background-color: @row_alternate;
}

QHeaderView::section {
  background: @panel;
  color: @text_dim;
  border: none;
  border-bottom: 1px solid @border;
  border-right: 1px solid @list_divider;
  padding: 6px 8px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

QHeaderView::section:hover {
  color: @text_heading;
}

QHeaderView::down-arrow {
  image: @chevron_down;
  width: 10px;
  height: 10px;
}

QHeaderView::up-arrow {
  image: @chevron_up;
  width: 10px;
  height: 10px;
}

QTableView {
  background: @field;
  border: 1px solid @border;
  border-radius: 6px;
  gridline-color: @list_divider;
  selection-background-color: @selection;
  selection-color: @text_selected;
  alternate-background-color: @row_alternate;
}

QTableView QTableCornerButton::section {
  background: @panel;
  border: none;
}

QTabWidget::pane {
  border: 1px solid @border;
  border-radius: 8px;
  top: -1px;
}

/* Tabs read as a row of names, the current one underlined. */
QTabBar::tab {
  background: transparent;
  color: @text_dim;
  padding: 8px 14px;
  border: none;
  border-bottom: 2px solid transparent;
  margin-right: 2px;
}

QTabBar::tab:hover {
  color: @text_heading;
}

QTabBar::tab:selected {
  color: @text_bright;
  border-bottom: 2px solid @accent;
}

QTabBar::scroller {
  width: 28px;
}

QTabBar QToolButton {
  padding: 2px;
}

#inspectorSummary {
  color: @text_soft;
  font-size: 13px;
  padding: 4px 2px;
}

#inspectorPayload {
  font-family: @font_mono;
  font-size: 12px;
  color: @text_payload;
}

/* --- menus, status bar, dialogs -------------------------------------- */

QMenuBar {
  background: @panel;
  border-bottom: 1px solid @border;
}

QMenuBar::item:selected {
  background: @button_hover;
}

QMenuBar::item {
  padding: 4px 10px;
  border-radius: 5px;
  background: transparent;
}

QMenu {
  background: @panel;
  border: 1px solid @control_border;
  border-radius: 8px;
  padding: 6px;
}

QMenu::item {
  padding: 7px 28px 7px 28px;
  border-radius: 5px;
}

QMenu::item:selected {
  background: @selection;
  color: @text_selected;
}

QMenu::item:disabled {
  color: @text_hint;
}

QMenu::separator {
  height: 1px;
  background: @border;
  margin: 5px 10px;
}

QMenu::right-arrow {
  image: @chevron_right;
  width: 12px;
  height: 12px;
}

/* A ticked item (View → Prompt page, a branch being read): a check mark. */
QMenu::indicator {
  width: 14px;
  height: 14px;
  left: 8px;
}

QMenu::indicator:checked {
  image: @check;
}

QStatusBar {
  background: @panel;
  border-top: 1px solid @border;
}

QStatusBar::item {
  border: none;
}

/* Busy indicators: background jobs (QProgressDialog) and drafting. */
QProgressBar {
  background: @panel;
  border: 1px solid @control_border;
  border-radius: 3px;
  min-height: 6px;
}

QProgressBar::chunk {
  background: @accent;
  border-radius: 3px;
}

/* The storyteller's model, clickable (main_window.choose_story_model); its
   route and the plot's clock beside it look the same. */
#modelButton, #clockButton {
  background: transparent;
  border: 1px solid @control_border;
  border-radius: 4px;
  padding: 2px 8px;
  color: @text_soft;
  font-size: 12px;
}

#modelButton:hover, #clockButton:hover {
  background: @button;
  color: @text_bright;
}

#modelButton:disabled, #clockButton:disabled {
  color: @text_disabled;
}

#statusLabel {
  color: @text_dim;
  font-size: 12px;
  padding: 0 8px;
  background: transparent;
}

#budgetBar {
  background: transparent;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
  background: @panel;
  border: 1px solid @control_border;
  border-radius: 6px;
  padding: 6px 8px;
  color: @text_bright;
  selection-background-color: @text_selection;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
  border-color: @hover_border;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
  border-color: @accent;
}

QPlainTextEdit:focus, QTextEdit:focus {
  border-color: @accent;
}

/* Drop-downs and spin boxes draw their own arrows: chevrons in the text's
   colour. Qt's were black on these grounds, spin boxes' all but invisible. */
QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: center right;
  width: 24px;
  border: none;
  background: transparent;
}

QComboBox::down-arrow {
  image: @chevron_down;
  width: 14px;
  height: 14px;
}

QComboBox::down-arrow:on {
  image: @chevron_up;
}

QComboBox::down-arrow:disabled {
  image: @chevron_down_disabled;
}

QSpinBox, QDoubleSpinBox {
  padding-right: 28px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-origin: border;
  width: 24px;
  background: @button;
  border: none;
  border-left: 1px solid @control_border;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
  subcontrol-position: top right;
  border-top-right-radius: 6px;
  border-bottom: 1px solid @control_border;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-position: bottom right;
  border-bottom-right-radius: 6px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
  background: @button_hover;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
  background: @button_pressed;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
  image: @chevron_up;
  width: 12px;
  height: 12px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
  image: @chevron_down;
  width: 12px;
  height: 12px;
}

QSpinBox::up-arrow:hover, QDoubleSpinBox::up-arrow:hover {
  image: @chevron_up_hover;
}

QSpinBox::down-arrow:hover, QDoubleSpinBox::down-arrow:hover {
  image: @chevron_down_hover;
}

QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled,
QSpinBox::up-arrow:off, QDoubleSpinBox::up-arrow:off {
  image: @chevron_up_disabled;
}

QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled,
QSpinBox::down-arrow:off, QDoubleSpinBox::down-arrow:off {
  image: @chevron_down_disabled;
}

QLineEdit:disabled, QComboBox:disabled, QPlainTextEdit:disabled {
  background: @field_disabled;
  border-color: @border;
  color: @text_disabled;
}

QComboBox QAbstractItemView {
  background: @panel;
  border: 1px solid @control_border;
  border-radius: 6px;
  padding: 4px;
  selection-background-color: @selection;
  selection-color: @text_selected;
  outline: none;
}

/* --- settings review ----------------------------------------------- */

#changeRow {
  background: @panel;
  border: 1px solid @border;
  border-radius: 8px;
}

#changeRow QLabel, #changeRow QCheckBox {
  background: transparent;
}

#cannotFix {
  color: @warning;
  font-size: 13px;
  background: @warning_bg;
  border: 1px solid @warning_border;
  border-radius: 6px;
  padding: 8px;
}

#hintLabel {
  color: @text_hint;
  font-size: 12px;
}

#errorLabel {
  color: @error;
  font-size: 13px;
}

QCheckBox, QRadioButton {
  spacing: 8px;
}

/* Qt's default indicators are dark-on-dark here: an unchecked box or radio
   was all but invisible, so draw them outright. */
QCheckBox::indicator, QListView::indicator, QRadioButton::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid @indicator_border;
  background: @field;
}

QCheckBox::indicator, QListView::indicator {
  border-radius: 3px;
}

QRadioButton::indicator {
  border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
  border-color: @hover_border;
}

/* Ticked: the accent with a check mark (it was a filled square). */
QCheckBox::indicator:checked, QListView::indicator:checked {
  background: @primary;
  border-color: @primary_border;
  image: @check;
}

/* Chosen: a dot in the accent. */
QRadioButton::indicator:checked {
  border-color: @accent;
  background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
    stop: 0 @accent, stop: 0.45 @accent, stop: 0.55 @field, stop: 1 @field);
}

QCheckBox::indicator:disabled, QListView::indicator:disabled {
  border-color: @control_border;
}

QScrollBar:vertical {
  background: transparent;
  width: 11px;
  margin: 2px;
}

/* Light enough to find: #2f3441 on the panels' #16181d was all but invisible. */
QScrollBar::handle:vertical {
  background: @scrollbar;
  border-radius: 5px;
  min-height: 28px;
}

QScrollBar::handle:vertical:hover {
  background: @scrollbar_hover;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0;
}

QScrollBar:horizontal {
  background: transparent;
  height: 11px;
  margin: 2px;
}

QScrollBar::handle:horizontal {
  background: @scrollbar;
  border-radius: 5px;
  min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
  background: @scrollbar_hover;
}

QScrollBar::add-page, QScrollBar::sub-page {
  background: transparent;
}

QSlider::groove:horizontal {
  height: 4px;
  background: @control_border;
  border-radius: 2px;
}

QSlider::sub-page:horizontal {
  background: @accent;
  border-radius: 2px;
}

QSlider::handle:horizontal {
  background: @text_bright;
  border: 1px solid @control_border;
  width: 14px;
  height: 14px;
  margin: -6px 0;
  border-radius: 8px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  height: 0;
  width: 0;
}

QToolTip {
  background: @button;
  color: @text_bright;
  border: 1px solid @hover_border;
  border-radius: 6px;
  padding: 6px 8px;
}

/* --- private scenes ------------------------------------------------------ */

#privateToggle:checked {
  background: @private_toggle_bg;
  border-color: @private_toggle_border;
  color: @private_toggle_text;
}

#input[private="true"], #oocInput[private="true"] {
  background: @private_input_bg;
  border: 1px solid @private_input_border;
}

#mapPaused {
  background: @private_bg;
  border-left: 3px solid @private_mark;
  color: @private_text;
  padding: 6px 8px;
}

#message[private="true"] {
  border-left: 3px solid @private_mark;
  background: @private_bg;
}

#message[private="true"] #messageBody {
  color: @private_text;
}

#message[kind="assistant"][privatesummary="true"] {
  border-left: 3px solid @private_mark;
  border-style: dashed;
}

#warningLabel {
  color: @warning;
  font-size: 12px;
}

/* The inspector's pages: two rows of buttons (gui/tab_rows.py), every page
   one click away, where a tab strip hid the last ones behind arrows. */
#tabRowButton {
  background: @panel;
  border: 1px solid @border;
  border-radius: 6px;
  color: @text_dim;
  padding: 5px 6px;
}

#tabRowButton:hover {
  color: @text_heading;
  border-color: @button_border;
}

#tabRowButton:checked {
  background: @selection;
  color: @text_bright;
  border-color: @checked_border;
}

/* The inspector with no story open (main_window._no_story_page). */
#emptyTitle {
  color: @text_heading;
  font-size: 15px;
  font-weight: 600;
  padding-bottom: 4px;
}

#placeholderButton {
  padding: 6px 14px;
}
