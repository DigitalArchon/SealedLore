# What the AppImage ships, at the versions the test suite runs against. Bump
# deliberately, then run packaging/appimage/lock.sh to pin everything they
# pull in, by hash, into requirements.lock.
pydantic==2.13.5
httpx==0.28.1
tiktoken==0.14.0
numpy==2.5.3
# Essentials, not PySide6: the add-ons are hundreds of megabytes the app
# never imports, all but QtMultimedia and its FFmpeg, which play videos
# (gui/video_view.py). build.sh keeps those and deletes the rest.
PySide6-Essentials==6.11.2
PySide6-Addons==6.11.2
# End-to-end encrypted private models: Tinfoil's attestation and EHBP client
# (providers/private_mode.py). It pulls in sigstore, cryptography and the
# OpenAI client; all pinned by hash below like everything else. The EHBP
# library and its HPKE are named too: tinfoil accepts any tinfoil-ehbp>=0.3.0,
# so a relock would otherwise take a newer one nobody has read.
tinfoil==0.14.0
tinfoil-ehbp==0.3.2
pyhpke==0.6.5
# API keys in the system keychain (storage/keychain.py), as the author's
# DAToolkit does: on Linux through SecretStorage and jeepney (pure Python;
# cryptography is tinfoil's already).
keyring==25.7.0
# The CA bundle httpx, requests and sigstore trust. 2026.10.19 drops emSign
# ECC Root CA - G3, whose eMudhra intermediates had recoverable keys (Oct
# 2026); the floor keeps a relock from standing still on an older one. Pinned
# by hash below like everything else. The AppImage prefers the host's own CA
# store (AppRun) and falls back to this.
certifi>=2026.10.19
