# What the AppImage ships, at the versions the test suite runs against. Bump
# deliberately, then run packaging/appimage/lock.sh to pin everything they
# pull in, by hash, into requirements.lock.
pydantic==2.13.5
httpx==0.28.1
tiktoken==0.14.0
numpy==2.5.3
# Essentials, not PySide6: the add-ons are hundreds of megabytes the app
# never imports, all but QtMultimedia and its FFmpeg, which play videos
# (gui/video_view.py). build.sh keeps those and deletes the rest.
PySide6-Essentials==6.11.3
PySide6-Addons==6.11.3
# End-to-end encrypted private models: Tinfoil's attestation and EHBP client
# (providers/private_mode.py). It pulls in sigstore, cryptography and the
# OpenAI client; all pinned by hash below like everything else. The EHBP
# library and its HPKE are named too: tinfoil accepts any tinfoil-ehbp>=0.3.0,
# so a relock would otherwise take a newer one nobody has read.
# 0.15.0 and 0.4.1 (requests sealed in 64 KiB frames) were run against the
# enclave on Oct 22 2026 before being adopted (SealedLoreDocs design/private.md).
tinfoil==0.15.0
tinfoil-ehbp==0.4.1
pyhpke==0.6.5
# The attestation's fetch guard (providers/sdk_guard.py) reads sigstore 4.5's and
# tuf 7.0's internals: held there until a newer one is read.
sigstore>=4.5,<4.6
tuf>=7.0,<7.1
# API keys in the system keychain (storage/keychain.py), as the author's
# DAToolkit does: on Linux through SecretStorage and jeepney (pure Python;
# cryptography is tinfoil's already).
keyring==25.7.0
# Embeddings made on this computer (providers/local_embeddings.py): bge-m3 in
# ONNX Runtime, its text split by Hugging Face's tokenizer. tokenizers pulls in
# huggingface-hub (and its own), which the app never calls: the model's files
# are fetched and checked by the app itself. Both out over three weeks when
# adopted (Nov 20 2026).
onnxruntime==1.31.1
tokenizers==0.23.3
# Never shipped (lock.sh's NOT_SHIPPED leaves it and what only it needs out of
# the lock), but resolved with the rest: held here, so a relock never moves a
# package that ships to suit a newer hub.
huggingface-hub==2.4.0
# The CA bundle httpx, requests and sigstore trust. 2026.10.19 drops emSign
# ECC Root CA - G3, whose eMudhra intermediates had recoverable keys (Oct
# 2026); the floor keeps a relock from standing still on an older one. Pinned
# by hash below like everything else. The AppImage prefers the host's own CA
# store (AppRun) and falls back to this.
certifi>=2026.10.19
# Floors past advisories, which a relock otherwise never crosses (uv keeps
# what the lock pins; lock.sh's UPGRADE=1 re-resolves everything). pyasn1,
# which tinfoil and sigstore decode attestation certificates' extensions
# with: 0.6.5 fixes four denials of service in its decoders
# (GHSA-2qm8-x737-gmw5, GHSA-fm9c-5rcf-2q5p, GHSA-mm57-4v3p-rchx,
# GHSA-9m75-vc3g-4x39; Oct 2026). dnspython: 2.9.0 fixes one in its name
# parser (GHSA-45c3-73f7-pv4m). cryptography: 50.0.2, as the author's other
# apps have it (1.0.0b1 to 3.1.0b5 shipped 50.0.1). As DA Assistant floors
# them (9b1d6b8, Nov 2026).
pyasn1>=0.6.5
dnspython>=2.9.0
cryptography>=50.0.2
